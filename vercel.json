{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30,
      "excludeFiles": "{storage/**,tests/**,tools/**,template-original/**,.git/**,.env*,*.md,images/**,css/**,js/**}"
    }
  },
  "routes": [
    { "src": "/assets/(site|refined|modern|articles|cinar|mizan|juris-home|profile|classic|admin)\\.css", "headers": { "X-Content-Type-Options": "nosniff" }, "continue": true },
    { "src": "/assets/(site|admin|theme-admin)\\.js", "headers": { "X-Content-Type-Options": "nosniff" }, "continue": true },
    { "src": "/assets/((?:site|refined|modern|articles|cinar|mizan|juris-home|profile|classic|admin)\\.css|(?:site|admin|theme-admin)\\.js)", "dest": "/assets/$1" },
    { "src": "/assets/(images/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(?:jpg|jpeg|png|webp|svg|gif|avif)|fonts/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(?:ttf|woff2|woff|eot))", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
